{
  "database": "https://iptv-org.github.io/api",
  "extraSources": [
    {
      "name": "free-tv",
      "url": "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8"
    },
    {
      "name": "my-own",
      "file": "data/custom.m3u"
    }
  ],
  "filters": {
    "onePerFeed": true,
    "excludeNsfw": true,
    "excludeBlocklist": true,
    "excludeClosedChannels": false,
    "skipNonHttp": false
  },
  "favourites": {
    "countries": ["dk", "fr", "sn", "gm"],
    "categories": ["sports", "news", "movies", "kids", "documentary"],
    "skipDead": true
  },
  "guides": {
    "countries": ["dk", "fr", "sn", "gm"],
    "preferSites": ["allente.dk", "tv.nu", "programme-tv.net", "canalplus.com", "i.mjh.nz", "pluto.tv"],
    "days": 1
  },
  "extraGuideUrls": [],
  "check": {
    "timeoutMs": 10000,
    "concurrency": 60
  },
  "guideInPlaylists": false
}
