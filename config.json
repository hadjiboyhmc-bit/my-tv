{
  "database": "https://iptv-org.github.io/api",
  "extraSources": [
    {
      "name": "free-tv",
      "url": "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8"
    },
    {
      "name": "my-own",
      "file": "data/custom.m3u"
    }
  ],
  "filters": {
    "onePerFeed": true,
    "excludeNsfw": true,
    "excludeBlocklist": true,
    "excludeClosedChannels": false,
    "skipNonHttp": false
  },
  "favourites": {
    "countries": ["dk", "se", "no", "uk", "de"],
    "categories": ["news", "sports", "movies", "kids", "documentary"]
  },
  "guides": {
    "countries": ["dk", "se", "no", "uk", "de"],
    "preferSites": ["tv.nu", "tv24.se", "allente.dk", "sky.com", "i.mjh.nz", "pluto.tv"],
    "days": 2
  },
  "extraGuideUrls": [],
  "check": {
    "timeoutMs": 10000,
    "concurrency": 60
  }
}
